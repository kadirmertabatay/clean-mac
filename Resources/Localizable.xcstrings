    "%@ free · %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ boş · %2$@"
          }
        }
      }
    },
    "%@ keeps images, containers and the build cache in a single virtual disk. You can clean up unused items, or remove Docker entirely if you don’t use it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ imajları, konteynerleri ve derleme önbelleği tek bir sanal diskte tutulur. Kullanılmayanları temizleyebilir ya da Docker'ı hiç kullanmıyorsan kaldırabilirsin."
          }
        }
      }
    },
    "%@ needs to be scanned at least twice to compare. A summary is saved after the first scan.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırma için %@ en az iki kez taranmalı. İlk taramadan sonra özet saklanır."
          }
        }
      }
    },
    "%@ not visible to the scan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ taramada görünmüyor"
          }
        }
      }
    },
    "%@ of %@ used": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ kullanılıyor"
          }
        }
      }
    },
    "%@ restored. Scan again to refresh the lists.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geri alındı. Listeleri güncellemek için yeniden tarayabilirsin."
          }
        }
      }
    },
    "%@ safe to clean": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güvenle temizlenebilir"
          }
        }
      }
    },
    "%@ wasn’t found in the Trash (it may have been emptied).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Çöp Kutusu'nda bulunamadı (çöp boşaltılmış olabilir)."
