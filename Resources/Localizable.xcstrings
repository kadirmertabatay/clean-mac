          }
        }
      }
    },
    "Also check the recommendations in System Settings › General › Storage.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları › Genel › Depolama bölümündeki önerileri de kontrol et."
          }
        }
      }
    },
