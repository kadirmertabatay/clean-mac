    "A local storage assistant for your Mac": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'in için yerel depolama asistanı"
          }
        }
      }
    },
    "A scan is needed first": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir tarama gerekli"
          }
        }
      }
    },
    "A summary of every scan is kept; compare with earlier scans to find where your space went.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her taramanın özeti saklanır; alanın nereye gittiğini önceki taramalarla karşılaştırarak bul."
          }
        }
      }
    },
    "Add Folder": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör Ekle"
          }
        }
      }
