          }
        }
      }
    },
    "Runs `brew cleanup -s`: old package versions and the download cache are deleted. Your installed packages keep working.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew cleanup -s` çalışacak: eski paket sürümleri ve indirme önbelleği silinir. Yüklü paketlerin çalışmaya devam eder."
          }
        }
      }
    },
    "Runs `docker builder prune`.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`docker builder prune` çalışacak."
          }
        }
      }
    },
    "Runs `docker system prune -a`: stopped containers, unused networks, ALL images not used by any container, and the build cache are deleted permanently. Volumes are kept.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`docker system prune -a` çalışacak: durmuş konteynerler, kullanılmayan ağlar, HİÇBİR konteynerin kullanmadığı tüm imajlar ve derleme önbelleği kalıcı olarak silinir. Birimler (volume) korunur."
          }
        }
      }
    },
    "Runs `docker system prune`: stopped containers, unused networks, dangling images and the build cache are deleted permanently. Volumes are kept.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`docker system prune` çalışacak: durmuş konteynerler, kullanılmayan ağlar, etiketsiz imajlar ve derleme önbelleği kalıcı olarak silinir. Birimler (volume) korunur."
          }
        }
      }
    },
    "Runs `xcrun simctl delete unavailable`: simulators for iOS versions that are no longer installed are deleted permanently.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`xcrun simctl delete unavailable` çalışacak: artık yüklü olmayan iOS sürümlerine ait simülatörler kalıcı olarak silinir."
          }
        }
      }
    },
    "Safe": {
      "localizations": {
        "tr": {
          "stringUnit": {
