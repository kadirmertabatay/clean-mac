    "Add Rule": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural Ekle"
          }
        }
      }
    },
    "Add Suggested Rules": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen Kuralları Ekle"
          }
        }
      }
    },
    "Add a rule such as \"clean app caches every week\". By default, rules ask you first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örneğin \"her hafta uygulama önbelleklerini temizle\" gibi bir kural ekle. Kurallar varsayılan olarak önce sana sorar."
          }
        }
      }
    },
    "Add your active projects, important archives, or any folder you don’t want touched. You can also right-click in a list and choose \"Exclude\".": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif projelerini, önemli arşivlerini ya da dokunulmasını istemediğin klasörleri ekle. Listelerde sağ tıklayıp \"Hariç Tut\" diyerek de ekleyebilirsin."
          }
        }
      }
    },
    "Add…": {
      "localizations": {
