                      "state": "translated",
                      "value": "%arg unused image"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg unused images"
                    }
                  }
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kullanılmayan imaj silinsin mi?"
          }
        }
      }
    },
