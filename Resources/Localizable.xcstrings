    "%lld items will be moved to the Trash%@. They can be restored from History. Protected areas aren’t touched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@arg1@ will be moved to the Trash%2$@. They can be restored from History. Protected areas aren’t touched."
          },
          "substitutions": {
